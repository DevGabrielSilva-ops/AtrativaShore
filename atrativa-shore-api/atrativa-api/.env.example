# Copie para .env e ajuste. O .env NUNCA deve ir para o Git (já está no .gitignore).

# ---------------------------------------------------------------- servidor
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
# Origens do frontend permitidas no CORS (separe por vírgula)
CORS_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=true

# ---------------------------------------------------------------- banco MySQL
# O usuário precisa poder criar bancos (CREATE): cada empresa ativada ganha o seu.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USERNAME=root
DB_PASSWORD=sua_senha
# Banco do sistema anterior, usado por "npm run plataforma:importar" quando nenhum nome é informado
DB_DATABASE=Atrativa
DB_CHARSET=utf8mb4
DB_LOGGING=false

# ---------------------------------------------------------------- plataforma multiempresa
# Banco central (empresas, usuários, códigos de ativação, auditoria)
DB_PLATAFORMA=atrativa_plataforma
# Prefixo dos bancos das empresas novas (atrativa_emp_2, atrativa_emp_3, ...)
DB_EMPRESA_PREFIXO=atrativa_emp_
DB_CONEXOES_POR_EMPRESA=5
# Validade padrão dos códigos de ativação, em dias
ATIVACAO_VALIDADE_DIAS=7

# Superadministrador inicial: usado só por "npm run plataforma:superadmin".
# Depois de criado, apague a senha daqui.
SUPERADMIN_NOME=Administrador da plataforma
SUPERADMIN_EMAIL=
SUPERADMIN_SENHA=

# ---------------------------------------------------------------- autenticação
# Gere um segredo forte: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=altere_esta_chave_por_um_valor_aleatorio_de_pelo_menos_32_caracteres
# Access token curto; a sessão é renovada pelo refresh token (cookie httpOnly)
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DIAS=7
REFRESH_TOKEN_HORAS_SESSAO=12
# Em produção com HTTPS use COOKIE_SECURE=true; frontend em outro domínio exige COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
BCRYPT_ROUNDS=10

# ---------------------------------------------------------------- regras da loja
APP_TIMEZONE=America/Sao_Paulo
# id do registro em cad_empresa dentro do banco de cada empresa
EMPRESA_ID=1
# Terminal e turno que a API usa em vendas e caixa. O desktop usa o terminal 01;
# com 02 os caixas da API e do desktop ficam separados.
PDV_TERMINAL=02
PDV_TURNO=1
# Exige caixa aberto para registrar vendas e receber carnês
EXIGIR_CAIXA_ABERTO=true
# Limite do "estoque baixo" para produtos sem estoque mínimo cadastrado
ESTOQUE_BAIXO_LIMITE=3
CARNE_MAX_PARCELAS=12
# Limite de compras no carnê = parcelas em aberto que o cliente pode ter.
# Calculado como este percentual da faixa salarial (50 = metade da renda),
# salvo se o cliente tiver um limite manual no cadastro.
CARNE_LIMITE_PERCENTUAL_RENDA=50
# Limite (R$) para clientes sem faixa salarial cadastrada
CARNE_LIMITE_PADRAO=300


# ---------------------------------------------------------------- backups
# Pasta onde os ZIPs ficam até expirar (nunca exposta publicamente; fora do Git)
BACKUP_DIR=armazenamento/backups
# Horas que o arquivo fica disponível para download antes de ser apagado (1 a 720)
BACKUP_RETENCAO_HORAS=24
# Caminho do mysqldump para o backup global (opcional; sem ele, usa o exportador interno)
# MYSQLDUMP_PATH=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysqldump.exe

# ---------------------------------------------------------------- testes e2e (opcional)
# E2E_SAAS=true cria bancos temporários e2e_* (plataforma + 2 empresas), testa o
# isolamento e apaga esses bancos no fim. Use um servidor MySQL de teste.
# E2E_SAAS=true
# E2E_DB_HOST=127.0.0.1
# E2E_DB_PORT=3307
# E2E_DB_USERNAME=root
# E2E_DB_PASSWORD=
