# Copie para .env e ajuste. O .env NUNCA deve ir para o Git (já está no .gitignore).

# ---------------------------------------------------------------- servidor
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
# Origens do frontend permitidas no CORS (separe por vírgula)
CORS_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=true

# ---------------------------------------------------------------- banco MySQL (já existente)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USERNAME=atrativa
DB_PASSWORD=sua_senha
DB_DATABASE=atrativaLoja
DB_CHARSET=utf8mb4
DB_LOGGING=false

# ---------------------------------------------------------------- autenticação
# Gere um segredo forte: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=altere_esta_chave_por_um_valor_aleatorio_de_pelo_menos_32_caracteres
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=10

# ---------------------------------------------------------------- regras da loja
APP_TIMEZONE=America/Sao_Paulo
# id da empresa em cad_empresa (o banco tem uma só)
EMPRESA_ID=1
# Terminal e turno que a API usa em vendas e caixa. O desktop usa o terminal 01;
# com 02 os caixas da API e do desktop ficam separados.
PDV_TERMINAL=02
PDV_TURNO=1
# Exige caixa aberto para registrar vendas e receber carnês
EXIGIR_CAIXA_ABERTO=true
# Limite do "estoque baixo" para produtos sem estoque mínimo cadastrado
ESTOQUE_BAIXO_LIMITE=3
CARNE_MAX_PARCELAS=12

# ---------------------------------------------------------------- testes e2e (opcional)
# Banco SEPARADO, com o dump importado e as migrations aplicadas.
# Os testes gravam dados nele. Nunca aponte para o banco em uso.
# E2E_DB_DATABASE=atrativa_teste
# E2E_LOGIN=ATRATIVA
# E2E_SENHA=
